---
const links = [
  { href: '/work', label: 'Work' },
  { href: '/writing', label: 'Writing' },
  { href: '/about', label: 'About' },
];
const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="sticky top-0 z-40 border-b border-line bg-bg/85 backdrop-blur-md">
  <nav class="wrap flex h-16 items-center justify-between" aria-label="Main">
    <a href="/" class="font-display text-[0.95rem] font-600 tracking-tight" aria-label="Home">
      Tanner&nbsp;Kunz
    </a>

    <ul class="flex items-center gap-7 text-[0.9rem]">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={isActive(link.href) ? 'page' : undefined}
              class:list={[
                'link-wipe py-2 transition-colors duration-200',
                isActive(link.href) ? 'text-ink' : 'text-ink-muted hover:text-ink',
              ]}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
