---
import ModeToggle from './ModeToggle.astro';

const links = [
  { href: '/work', label: 'Work' },
  { href: '/research', label: 'Research' },
  { href: '/writing', label: 'Writing' },
  { href: '/about', label: 'About' },
];
const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="sticky top-0 z-40 border-b border-line bg-bg/85 backdrop-blur-md">
  <nav class="wrap flex min-h-16 flex-wrap items-center justify-between gap-x-6 gap-y-3 py-4" aria-label="Main">
    <a href="/" class="font-display text-[0.95rem] font-600 tracking-tight" aria-label="Home">
      Tanner&nbsp;Kunz
    </a>

    <div class="flex items-center gap-5">
      <ul class="flex items-center gap-4 text-[0.9rem] sm:gap-7">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={isActive(link.href) ? 'page' : undefined}
              class:list={[
                'link-wipe py-2 transition-colors duration-200',
                isActive(link.href) ? 'text-ink' : 'text-ink-muted hover:text-ink',
              ]}
            >
              {link.label}
            </a>
          </li>
        ))
      }
      </ul>
      <ModeToggle />
    </div>
  </nav>
</header>
