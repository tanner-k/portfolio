---
// Permanent feature: lets a visitor override their OS colour scheme.
// Cycles system -> light -> dark -> system.
---

<button
  type="button"
  data-mode-toggle
  class="-mr-2 inline-flex h-11 w-11 items-center justify-center rounded-lg text-ink-muted transition-colors duration-200 hover:bg-surface-alt hover:text-ink"
  aria-label="Colour theme: follow system. Activate to switch to light."
>
  <svg class="h-[18px] w-[18px]" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <g data-icon="system"><rect x="2.5" y="3.5" width="15" height="10" rx="1.5" /><path d="M7 16.5h6" /></g>
    <g data-icon="light" hidden><circle cx="10" cy="10" r="3.5" /><path d="M10 2v1.5M10 16.5V18M18 10h-1.5M3.5 10H2M15.7 4.3l-1 1M5.3 14.7l-1 1M15.7 15.7l-1-1M5.3 5.3l-1-1" /></g>
    <g data-icon="dark" hidden><path d="M16.5 11.8A7 7 0 0 1 8.2 3.5a7 7 0 1 0 8.3 8.3Z" /></g>
  </svg>
</button>

<script>
  const MODES = ['system', 'light', 'dark'] as const;
  type Mode = (typeof MODES)[number];

  const LABEL: Record<Mode, string> = {
    system: 'follow system',
    light: 'light',
    dark: 'dark',
  };

  const root = document.documentElement;
  const button = document.querySelector<HTMLButtonElement>('[data-mode-toggle]');

  function render(mode: Mode) {
    if (mode === 'system') root.removeAttribute('data-mode');
    else root.setAttribute('data-mode', mode);

    button?.querySelectorAll<SVGGElement>('[data-icon]').forEach((icon) => {
      icon.toggleAttribute('hidden', icon.dataset.icon !== mode);
    });

    const next = MODES[(MODES.indexOf(mode) + 1) % MODES.length];
    button?.setAttribute(
      'aria-label',
      `Colour theme: ${LABEL[mode]}. Activate to switch to ${LABEL[next]}.`,
    );
  }

  function current(): Mode {
    const attr = root.getAttribute('data-mode');
    return attr === 'light' || attr === 'dark' ? attr : 'system';
  }

  button?.addEventListener('click', () => {
    const next = MODES[(MODES.indexOf(current()) + 1) % MODES.length];
    try {
      localStorage.setItem('mode', next);
    } catch {
      // Blocked storage — the choice applies now but won't persist.
    }
    render(next);
  });

  render(current());
</script>
