---
// Temporary chooser for palette and type pairing. Delete with themes.css,
// fonts.css and src/pages/palette.astro once both decisions are made.
const palettes = [
  { id: 'ink', label: 'Ink', note: 'graphite / blue' },
  { id: 'grove', label: 'Grove', note: 'ivory / forest green / walnut' },
  { id: 'harvest', label: 'Harvest', note: 'cream / walnut / olive' },
];

const fonts = [
  { id: 'grotesk', label: 'Grotesk', note: 'Space Grotesk — technical' },
  { id: 'bricolage', label: 'Bricolage', note: 'Bricolage Grotesque — soft, quirky' },
  { id: 'familjen', label: 'Familjen', note: 'Familjen Grotesk — flatter, squarer' },
  { id: 'schibsted', label: 'Schibsted', note: 'Schibsted Grotesk — neutral modern' },
  { id: 'cabinet', label: 'Cabinet', note: 'Cabinet Grotesk — boxiest, most display' },
  { id: 'fraunces', label: 'Fraunces', note: 'Fraunces — warm serif' },
];

const groups = [
  { key: 'palette', title: 'Palette', options: palettes },
  { key: 'font', title: 'Type', options: fonts },
];
---

<div
  class="fixed right-4 bottom-4 z-50 w-[13.5rem] rounded-xl border border-line bg-surface/95 p-3 shadow-lg backdrop-blur-md"
>
  {
    groups.map((group) => (
      <div class="mb-3 last:mb-0">
        <p class="px-1 pb-1.5 font-display text-[0.65rem] tracking-[0.14em] text-ink-muted uppercase">
          {group.title}
        </p>
        <div class="flex flex-wrap gap-1">
          {group.options.map((option) => (
            <button
              type="button"
              data-group={group.key}
              data-option={option.id}
              title={`${option.label} — ${option.note}`}
              class="rounded-lg px-2.5 py-1.5 font-display text-[0.78rem] text-ink-muted transition-colors duration-150 hover:bg-surface-alt hover:text-ink aria-pressed:bg-ink aria-pressed:text-bg"
              aria-pressed="false"
            >
              {option.label}
            </button>
          ))}
        </div>
      </div>
    ))
  }

  <a
    href="/palette"
    class="mt-1 block px-1 text-[0.7rem] text-ink-muted underline underline-offset-2 hover:text-ink"
  >
    See full palette
  </a>
</div>

<script>
  // group key -> [html attribute, value that means "default"]
  const GROUPS: Record<string, { attr: string; fallback: string }> = {
    palette: { attr: 'data-theme', fallback: 'ink' },
    font: { attr: 'data-font', fallback: 'grotesk' },
  };

  const root = document.documentElement;

  function apply(group: string, option: string) {
    const { attr, fallback } = GROUPS[group];
    if (option === fallback) root.removeAttribute(attr);
    else root.setAttribute(attr, option);

    document
      .querySelectorAll<HTMLButtonElement>(`[data-group="${group}"]`)
      .forEach((button) => {
        button.setAttribute('aria-pressed', String(button.dataset.option === option));
      });
  }

  document.querySelectorAll<HTMLButtonElement>('[data-group]').forEach((button) => {
    button.addEventListener('click', () => {
      const group = button.dataset.group!;
      const option = button.dataset.option!;
      try {
        localStorage.setItem(group, option);
      } catch {
        // Blocked storage — applies now, won't persist.
      }
      apply(group, option);
    });
  });

  for (const [group, { attr, fallback }] of Object.entries(GROUPS)) {
    apply(group, root.getAttribute(attr) ?? fallback);
  }
</script>
