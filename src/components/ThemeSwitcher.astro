---
// Temporary palette chooser. Delete this component, themes.css, and the two
// references in Base.astro once a palette is chosen.
const themes = [
  { id: 'ink', label: 'Ink', note: 'graphite / blue' },
  { id: 'grove', label: 'Grove', note: 'ivory / forest green / walnut' },
  { id: 'harvest', label: 'Harvest', note: 'cream / walnut / olive' },
];
---

<div
  class="fixed right-4 bottom-4 z-50 rounded-xl border border-line bg-surface/95 p-2 shadow-lg backdrop-blur-md"
  data-theme-switcher
>
  <p class="px-2 pt-1 pb-2 font-display text-[0.65rem] tracking-[0.14em] text-ink-muted uppercase">
    Palette
  </p>
  <div class="flex gap-1">
    {
      themes.map((theme) => (
        <button
          type="button"
          data-theme-option={theme.id}
          title={`${theme.label} — ${theme.note}`}
          class="rounded-lg px-3 py-2 font-display text-[0.8rem] text-ink-muted transition-colors duration-150 hover:bg-line/60 hover:text-ink aria-pressed:bg-ink aria-pressed:text-bg"
          aria-pressed="false"
        >
          {theme.label}
        </button>
      ))
    }
  </div>
  <a href="/palette" class="mt-1 block px-2 py-1 text-[0.7rem] text-ink-muted underline underline-offset-2 hover:text-ink">
    See full palette
  </a>
</div>

<script>
  const KEY = 'palette';
  const root = document.documentElement;

  function apply(theme: string) {
    if (theme === 'ink') root.removeAttribute('data-theme');
    else root.setAttribute('data-theme', theme);

    document.querySelectorAll<HTMLButtonElement>('[data-theme-option]').forEach((button) => {
      button.setAttribute('aria-pressed', String(button.dataset.themeOption === theme));
    });
  }

  document.querySelectorAll<HTMLButtonElement>('[data-theme-option]').forEach((button) => {
    button.addEventListener('click', () => {
      const theme = button.dataset.themeOption!;
      try {
        localStorage.setItem(KEY, theme);
      } catch {
        // Private mode or blocked storage — the choice just won't persist.
      }
      apply(theme);
    });
  });

  apply(root.getAttribute('data-theme') ?? 'ink');
</script>
