---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Marquee from '../components/Marquee.astro';
import ProjectCard from '../components/ProjectCard.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const marqueeItems = projects.map((p) => ({
  title: p.data.title,
  href: `/portfolio/work/${p.id}`,
  tagline: p.data.status,
}));
---

<Base
  title="AI engineer"
  description="I build AI systems and measure whether they work. Open to forward-deployed and AI engineering roles."
>
  <section class="cursor-glow relative overflow-hidden">
    <div class="wrap relative py-28 sm:py-36">
      <p class="font-display text-[0.85rem] tracking-[0.18em] text-primary uppercase">
        Tanner Kunz
      </p>

      <h1 class="mt-6 max-w-4xl text-[clamp(2.5rem,6.5vw,4.5rem)]">
        I build AI systems, then prove whether they work.
      </h1>

      <p class="prose-measure mt-7 text-lg text-ink-muted">
        I spent four years as a data scientist and AI engineer, building matching and retrieval
        systems over hundreds of millions of records. I&rsquo;m looking for a forward-deployed or
        AI engineering role, close to the customer&rsquo;s problem, shipping what holds up after
        the demo.
      </p>

      <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-4">
        <a
          href="/portfolio/work"
          class="rounded-full bg-primary px-6 py-3 font-display text-[0.95rem] text-bg transition-transform duration-200 ease-out hover:-translate-y-0.5 hover:brightness-110"
        >
          See the work
        </a>
        <a href="mailto:tanner.kunz22@gmail.com" class="link-wipe text-[0.95rem] text-ink-muted hover:text-ink">
          Start a conversation
        </a>
      </div>
    </div>
  </section>

  <Marquee items={marqueeItems} />

  <section class="wrap py-24">
    <div class="reveal">
      <h2 class="font-display text-[clamp(1.75rem,3.5vw,2.5rem)]">Selected work</h2>
      <p class="prose-measure mt-3 text-ink-muted">
        Things I&rsquo;ve built, why they exist, and what I learned shipping them.
      </p>
    </div>

    <div class:list={["mt-12 grid gap-6", projects.length > 1 && "sm:grid-cols-2"]}>
      {
        projects.map((project) => (
          <div class="reveal">
            <ProjectCard
              href={`/portfolio/work/${project.id}`}
              title={project.data.title}
              tagline={project.data.tagline}
              year={project.data.year}
              status={project.data.status}
              stack={project.data.stack}
            />
          </div>
        ))
      }
    </div>
  </section>

  <section class="mt-8 bg-surface-alt">
    <div class="wrap reveal grid gap-10 py-24 md:grid-cols-[1fr_1.4fr]">
      <h2 class="font-display text-[clamp(1.75rem,3.5vw,2.5rem)]">How I work</h2>
      <div class="space-y-4 text-ink-muted">
        <p>
          I start from the decision someone has to make, not from the model. In the Deere case
          study that meant asking whether a farm should own the machine at all, before asking
          whether its software paid off.
        </p>
        <p>
          I set the test before I run it, and I report the result when it goes against me. When a
          simple model beat my more complex one, I shipped the simple one.
        </p>
        <p>
          AI agents do most of my typing now. My part is choosing the problem, checking the
          evidence, and deciding what is true enough to ship.
        </p>
        <a href="/portfolio/about" class="link-wipe inline-block text-primary">More about how I work</a>
      </div>
    </div>
  </section>
</Base>
