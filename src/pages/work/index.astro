---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<Base title="Work" description="Case studies on the products I've designed, built, and shipped.">
  <section class="wrap py-20">
    <h1 class="text-[clamp(2.25rem,5vw,3.5rem)]">Work</h1>
    <p class="prose-measure mt-5 text-lg text-ink-muted">
      Each of these is a product I took from an idea to something real people use. The case studies
      cover the decisions, not just the stack.
    </p>

    <div class:list={["mt-14 grid gap-6", projects.length > 1 && "sm:grid-cols-2"]}>
      {
        projects.map((project) => (
          <div class="reveal">
            <ProjectCard
              href={`/work/${project.id}`}
              title={project.data.title}
              tagline={project.data.tagline}
              year={project.data.year}
              status={project.data.status}
              stack={project.data.stack}
            />
          </div>
        ))
      }
    </div>
  </section>
</Base>
