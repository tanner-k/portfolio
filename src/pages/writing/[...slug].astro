---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, date } = post.data;

const formatted = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC', // dates parse as UTC midnight; local formatting would show the previous day in US timezones
});
---

<Base title={title} description={description}>
  <article class="wrap post-article py-20">
    <a href="/portfolio/writing" class="link-wipe text-[0.9rem] text-ink-muted hover:text-ink print:hidden">← All writing</a>

    <header class="mt-8">
      <time datetime={date.toISOString()} class="text-[0.85rem] text-ink-muted tabular-nums">
        {formatted}
      </time>
      <h1 class="mt-3 max-w-3xl text-[clamp(2rem,4.5vw,3.25rem)]">{title}</h1>
    </header>

    <div
      class="post-body prose-measure mt-12 space-y-6 [&_h2]:mt-12 [&_h2]:font-display [&_h2]:text-2xl [&_li]:text-ink-muted [&_p]:text-lg [&_p]:text-ink-muted [&_strong]:text-ink [&_ul]:list-disc [&_ul]:space-y-2 [&_ul]:pl-5"
    >
      <Content />
    </div>
  </article>
</Base>

<style is:global>
  /* Rendered markdown carries no Astro scope attribute, hence is:global. Everything
     is keyed to .post-body / .post-article so no other page is affected. */

  /* Wide elements (tables, figures) may extend past the 34rem text column
     up to the page's content width. */
  .post-body { --bleed: min(65rem, calc(100vw - 3rem)); }

  .post-body a {
    color: var(--primary);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }
  .post-body a:hover { text-decoration-thickness: 2px; }

  .post-body h3 { margin-top: 2rem; font-size: 1.25rem; }
  .post-body h2 + h3 { margin-top: 0; }

  .post-body ol { list-style: decimal; padding-left: 1.25rem; }
  .post-body ol > li + li { margin-top: 0.5rem; }
  .post-body ol > li { color: var(--ink-muted); }

  .post-body code {
    font-size: 0.88em;
    padding: 0.1em 0.35em;
    border-radius: 4px;
    background: var(--surface-alt);
    color: var(--ink);
  }

  .post-body table {
    width: max-content;
    min-width: 100%;
    max-width: var(--bleed);
    border-collapse: collapse;
    font-size: 0.82rem;
    line-height: 1.45;
    font-variant-numeric: tabular-nums;
  }
  .post-body th,
  .post-body td {
    padding: 0.45rem 0.7rem;
    border: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
    color: var(--ink-muted);
  }
  .post-body th { background: var(--surface-alt); color: var(--ink); font-weight: 600; }
  /* Narrow screens: let the table scroll sideways instead of overflowing the page. */
  @media screen and (max-width: 48rem) {
    .post-body table { display: block; overflow-x: auto; }
  }

  .post-body figure { width: var(--bleed); margin-block: 2rem; }
  .post-body figure img {
    max-width: 100%;
    height: auto;
    background: #fff; /* the charts are opaque white; keep them a clean card in dark mode */
    border: 1px solid var(--line);
    border-radius: 6px;
  }
  .post-body figcaption {
    max-width: 44rem;
    margin-top: 0.6rem;
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--ink-muted);
  }

  .post-body .equation {
    overflow-x: auto;
    padding: 0.5rem 0;
    text-align: center;
    font-family: ui-serif, Georgia, 'Times New Roman', serif;
    font-size: 1.15rem;
    color: var(--ink);
  }

  /* ---- Print: the PDF of a post is made from this stylesheet. ---- */
  @page { size: Letter; margin: 0.75in; }

  @media print {
    /* Light palette whatever the screen mode was. */
    html:root {
      color-scheme: light !important;
      --bg: #fff;
      --surface: #fff;
      --surface-alt: #f2f2f2;
      --ink: #111;
      --ink-muted: #222;
      --line: #b8b8b8;
      --primary: #5a3418;
    }
    body { background: #fff; color: #111; font-size: 10.5pt; }

    /* Site chrome: nav (body > header), footer, mode toggle. The back link uses print:hidden. */
    body > header,
    body > footer,
    [data-mode-toggle] { display: none !important; }

    /* Scroll-reveal start states must not hide anything on paper. */
    .reveal { animation: none !important; opacity: 1 !important; transform: none !important; }

    .post-article { max-width: none; padding: 0; }
    .post-article h1 { font-size: 22pt; }
    .post-body { --bleed: 100%; max-width: none; margin-top: 1.25rem; }
    .post-body p,
    .post-body li { font-size: 10.5pt; line-height: 1.5; color: #1a1a1a; orphans: 3; widows: 3; }
    .post-body h2 { margin-top: 1.5rem; font-size: 15pt; }
    .post-body h3 { margin-top: 1.1rem; font-size: 12pt; }
    .post-body h2,
    .post-body h3,
    .post-body p:has(+ table),
    .post-body p:has(+ figure),
    .post-body p:has(+ .equation) { break-after: avoid; }
    .post-body a { color: #5a3418; }
    /* The PDF's own link is dead inside the PDF, so show it as plain text. */
    .post-body a[href$='.pdf'] { color: inherit; text-decoration: none; }
    .post-body code { background: #f2f2f2; print-color-adjust: exact; -webkit-print-color-adjust: exact; }

    .post-body table { font-size: 8.5pt; line-height: 1.35; break-inside: avoid; }
    .post-body thead { display: table-header-group; }
    .post-body tr { break-inside: avoid; }
    .post-body th,
    .post-body td { padding: 0.25rem 0.45rem; color: #111; }
    .post-body th { background: #e9e9e9; print-color-adjust: exact; -webkit-print-color-adjust: exact; }

    .post-body figure { break-inside: avoid; }
    .post-body figure img { max-width: 100%; max-height: 7.5in; width: auto; }
    .post-body figcaption { max-width: none; font-size: 9pt; color: #222; }
    .post-body .equation { font-size: 12pt; }
  }
</style>
